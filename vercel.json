{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/share/:page",
      "destination": "/api/share?page=:page"
    },
    {
      "source": "/feed",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|yandex|bingbot|slurp|duckduckbot|baiduspider|applebot|petalbot|seznambot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/crawler?path=/feed"
    },
    {
      "source": "/feed/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|yandex|bingbot|slurp|duckduckbot|baiduspider|applebot|petalbot|seznambot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/crawler?path=/feed/:slug"
    },
    {
      "source": "/mini-course",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|yandex|bingbot|slurp|duckduckbot|baiduspider|applebot|petalbot|seznambot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/crawler?path=/mini-course"
    },
    {
      "source": "/mini-course/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|yandex|bingbot|slurp|duckduckbot|baiduspider|applebot|petalbot|seznambot|google-inspectiontool).*"
        }
      ],
      "destination": "/api/crawler?path=/mini-course/:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-feed",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron-keepalive",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-health",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-trends",
      "schedule": "30 */6 * * *"
    }
  ]
}