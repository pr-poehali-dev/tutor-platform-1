{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Check без токена - анонимный гость",
      "method": "GET",
      "path": "/?action=check&course_id=1",
      "expectedStatus": 200,
      "expectedBody": {
        "authenticated": false,
        "has_subscription": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check с невалидным токеном - тоже гость",
      "method": "GET",
      "path": "/?action=check",
      "headers": {
        "X-Auth-Token": "invalid-token-xxx"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "authenticated": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Buy курса без токена - 401 (требуется вход)",
      "method": "POST",
      "path": "/?action=buy_course",
      "body": {
        "course_id": 1,
        "grade": "ege",
        "return_url": "https://example.com/ok"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Buy подписки без токена - 401 (требуется вход)",
      "method": "POST",
      "path": "/?action=buy_subscription",
      "body": {
        "plan_id": "pro",
        "return_url": "https://example.com/ok"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "validate_coupon: промокод ДОБРО даёт 30% без токена",
      "method": "POST",
      "path": "/?action=validate_coupon",
      "body": {
        "coupon_code": "ДОБРО",
        "amount_rub": 1000
      },
      "expectedStatus": 200,
      "expectedBody": {
        "valid": true,
        "percent": 30,
        "final_rub": 700
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "validate_coupon: неизвестный промокод - невалиден",
      "method": "POST",
      "path": "/?action=validate_coupon",
      "body": {
        "coupon_code": "НЕТ-ТАКОГО-КОДА",
        "amount_rub": 1290
      },
      "expectedStatus": 200,
      "expectedBody": {
        "valid": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "sync_payment без токена - 401",
      "method": "POST",
      "path": "/?action=sync_payment",
      "body": {},
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action - 404",
      "method": "GET",
      "path": "/?action=unknown",
      "expectedStatus": 404
    },
    {
      "name": "Промокод доступа без входа - 401",
      "method": "POST",
      "path": "/?action=redeem_access",
      "body": {
        "code": "САМАРА"
      },
      "expectedStatus": 401
    },
    {
      "name": "Промокод доступа без кода - 400",
      "method": "POST",
      "path": "/?action=redeem_access",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Пробная неделя без входа — 401",
      "method": "POST",
      "path": "/?action=tutor_start_trial",
      "body": {
        "source": "home"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Корзина: 3 курса — скидка 60%",
      "method": "POST",
      "path": "/?action=cart_quote",
      "body": {
        "course_ids": [
          17,
          57,
          72
        ]
      },
      "expectedStatus": 200,
      "expectedBody": {
        "count": 3,
        "discount_percent": 60,
        "total_rub": 21498.0,
        "final_rub": 8599.2
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Корзина: 2 курса — скидка 50%",
      "method": "POST",
      "path": "/?action=cart_quote",
      "body": {
        "course_ids": [
          17,
          57
        ]
      },
      "expectedStatus": 200,
      "expectedBody": {
        "count": 2,
        "discount_percent": 50,
        "final_rub": 8249.5
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Оплата корзины без входа — 401",
      "method": "POST",
      "path": "/?action=buy_cart",
      "body": {
        "course_ids": [
          17,
          57
        ],
        "return_url": "https://example.com/ok"
      },
      "expectedStatus": 401
    }
  ]
}