{
  "tests": [
    {
      "name": "Health-check агента",
      "method": "GET",
      "path": "/?action=ping",
      "expectedStatus": 200,
      "expectedBody": { "ok": true, "service": "tg-channel-agent" },
      "bodyMatcher": "partial"
    },
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Cron без токена запрещён",
      "method": "GET",
      "path": "/?action=cron",
      "expectedStatus": 401,
      "expectedBody": { "error": "unauthorized" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Статус без токена запрещён",
      "method": "GET",
      "path": "/?action=status",
      "expectedStatus": 401,
      "expectedBody": { "error": "unauthorized" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестное действие",
      "method": "GET",
      "path": "/?action=nonexistent",
      "expectedStatus": 404,
      "expectedBody": { "error": "unknown action" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вебхук принимает пустой апдейт",
      "method": "POST",
      "path": "/?action=webhook",
      "body": {},
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    }
  ]
}
