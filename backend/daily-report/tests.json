{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Предпросмотр отчёта работает",
      "method": "GET",
      "path": "/?action=preview",
      "expectedStatus": 200,
      "expectedBody": {"report": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Отправка без секрета запрещена",
      "method": "GET",
      "path": "/?action=send",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Ленивый запуск с сайта отвечает без секрета",
      "method": "GET",
      "path": "/?action=tick",
      "expectedStatus": 200,
      "expectedBody": {"sent": "boolean"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Диагностика без секрета запрещена",
      "method": "GET",
      "path": "/?action=diag",
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}