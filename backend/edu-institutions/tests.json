{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Нет доступа без PIN",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 403,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Рассылка без PIN закрыта",
      "method": "POST",
      "path": "/?action=outreach_send",
      "body": {
        "confirm": "SEND"
      },
      "expectedStatus": 403
    },
    {
      "name": "Отписка с неверной ссылкой",
      "method": "GET",
      "path": "/?action=unsubscribe&t=short",
      "expectedStatus": 400
    },
    {
      "name": "Шаг авторассылки публичный и безопасный",
      "method": "GET",
      "path": "/?action=pilot_tick",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Обзор пилота без PIN закрыт",
      "method": "GET",
      "path": "/?action=pilot_overview",
      "expectedStatus": 403
    },
    {
      "name": "Обзор «Малыша» без PIN закрыт",
      "method": "GET",
      "path": "/?action=kids_overview",
      "expectedStatus": 403
    },
    {
      "name": "Дособирание почты публичное и безопасное",
      "method": "GET",
      "path": "/?action=kids_enrich_tick",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Вход в админку со старым PIN 7777 закрыт",
      "method": "GET",
      "path": "/?action=admin_login",
      "headers": {
        "X-Admin-Pin": "7777"
      },
      "expectedStatus": 403
    },
    {
      "name": "Предпросмотр письма об ИИ-помощнике без PIN закрыт",
      "method": "GET",
      "path": "/?action=helper_letter_preview&audience=school",
      "expectedStatus": 403
    }
  ]
}